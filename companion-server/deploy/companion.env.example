# Copy to ~/.secrets/companion.env (chmod 600). Never commit the real file.
COMPANION_PEPPER=<random 32+ chars: openssl rand -hex 24>
COMPANION_DB=/home/ricki28/companion-data/companion.db
# Enrolment allowlist: Ricki's Telegram chat id only. Others get "not open yet".
COMPANION_ALLOWED_IDS=telegram:<ricki chat id>
# COMPANION_OPEN_ENROLMENT=1   # release step; only after privacy page, Data safety, listing copy are live
COMPANION_CONSENT_VERSION=1

# NEW Telegram bot from BotFather (never the assistant bot)
COMPANION_TELEGRAM_TOKEN=<from BotFather>
COMPANION_TELEGRAM_BOT=<bot username without @>
COMPANION_TELEGRAM_WEBHOOK_SECRET=<random: openssl rand -hex 24>

# Own OpenRouter key with a credit limit set on the key
COMPANION_OPENROUTER_KEY=<key>
COMPANION_MODEL=anthropic/claude-haiku-4.5
COMPANION_MONTHLY_CAP_USD=5
# Dogfood only, off by default: lets OPENROUTER_API_KEY stand in when the own key is missing
# COMPANION_ALLOW_SHARED_KEY=1

# WhatsApp Cloud API: leave unset until Meta is configured
# COMPANION_WA_ENABLED=1
# COMPANION_WA_NUMBER=<business number, digits only>
# COMPANION_WA_PHONE_ID=
# COMPANION_WA_TOKEN=
# COMPANION_WA_APP_SECRET=
# COMPANION_WA_VERIFY_TOKEN=
# COMPANION_WA_TEMPLATE=run_card
