<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- System splash (plan §4, B3): Android 12+ SplashScreen API, and androidx
         core-splashscreen on API 29-30 so every supported version looks the same.
         Light ground #FBFBF9 and the Track Bend mark; installSplashScreen() in MainActivity
         swaps to NormalTheme, then the Flutter Track Bend intro takes over. The same in
         light and dark mode: the app pins ThemeMode.light, so nothing ever flashes dark. -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/window_ground</item>
    </style>
</resources>
